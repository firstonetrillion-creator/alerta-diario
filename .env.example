# Public values. Published Sanity articles are queried at build time.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-31
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_EDITORIAL_OWNER=Alerta Diário
NEXT_PUBLIC_EDITORIAL_CONTACT_URL=
NEXT_PUBLIC_EDITORIAL_POLICY_APPROVED=false
NEXT_PUBLIC_PRIVACY_POLICY_APPROVED=false
NEXT_PUBLIC_CORRECTIONS_POLICY_APPROVED=false

# Set only after the publisher, policies, and content are ready.
NEXT_PUBLIC_PUBLICATION_READY=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_APPROVED=false
NEXT_PUBLIC_ADSENSE_CONSENT_READY=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=

# Local-only Sanity import token. Never prefix this with NEXT_PUBLIC or commit it.
SANITY_WRITE_TOKEN=

# Keep the Cloudflare Pages deploy-hook URL in Sanity's server-side webhook
# configuration. Do not add it to this file or to client-side code.
